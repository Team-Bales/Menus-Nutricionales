@page "/catalogo/alimentos/nuevo"
@page "/catalogo/alimentos/{Id:guid}/editar"
@inject ICatalogoApi Api
@inject NavigationManager Navegacion

<PageTitle>@(_esEdicion ? "Editar alimento" : "Nuevo alimento")</PageTitle>

<h1 class="h2 mb-4">@(_esEdicion ? "Editar alimento" : "Nuevo alimento")</h1>

@if (_cargando)
{
    <p class="text-muted">Cargando formulario…</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    <EditForm Model="_formulario" OnValidSubmit="Guardar" class="card shadow-sm formulario-catalogo">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="card-body">
            @if (_esEdicion)
            {
                <div class="alert alert-info small">El nombre no se modifica; la API solo permite reclasificar el alimento.</div>
            }
            <div class="mb-3">
                <label class="form-label" for="nombre">Nombre</label>
                <InputText id="nombre" class="form-control" @bind-Value="_formulario.Nombre" disabled="@_esEdicion" />
                <ValidationMessage For="@(() => _formulario.Nombre)" />
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="grupo">Grupo nutricional</label>
                    <InputSelect id="grupo" class="form-select" @bind-Value="_formulario.GrupoNutricionalId">
                        <option value="@Guid.Empty">Selecciona un grupo</option>
                        @foreach (var grupo in _grupos) { <option value="@grupo.Id">@grupo.Nombre</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formulario.GrupoNutricionalId)" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="tipo">Tipo de preparación</label>
                    <InputSelect id="tipo" class="form-select" @bind-Value="_formulario.TipoPreparacionId">
                        <option value="@Guid.Empty">Selecciona un tipo</option>
                        @foreach (var tipo in _tipos) { <option value="@tipo.Id">@tipo.Nombre</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formulario.TipoPreparacionId)" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="nivel">Nivel calórico</label>
                    <InputSelect id="nivel" class="form-select" @bind-Value="_formulario.NivelCaloricoId">
                        <option value="@Guid.Empty">Selecciona un nivel</option>
                        @foreach (var nivel in _niveles) { <option value="@nivel.Id">@nivel.Nombre</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formulario.NivelCaloricoId)" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="Volver">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@_guardando">@(_guardando ? "Guardando…" : "Guardar")</button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private readonly ClasificacionFormulario _formulario = new();
    private IReadOnlyList<Nomenclador> _grupos = [];
    private IReadOnlyList<Nomenclador> _tipos = [];
    private IReadOnlyList<Nomenclador> _niveles = [];
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private bool _esEdicion => Id is not null;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            _grupos = await Api.ListarGruposAsync();
            _tipos = await Api.ListarTiposPreparacionAsync();
            _niveles = await Api.ListarNivelesCaloricosAsync();
            if (Id is Guid id)
            {
                var alimento = await Api.ObtenerAlimentoAsync(id);
                _formulario.Nombre = alimento.Nombre;
                _formulario.GrupoNutricionalId = alimento.GrupoNutricionalId;
                _formulario.TipoPreparacionId = alimento.TipoPreparacionId;
                _formulario.NivelCaloricoId = alimento.NivelCaloricoId;
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task Guardar()
    {
        _guardando = true;
        _error = null;
        try
        {
            if (Id is Guid id)
            {
                await Api.ActualizarAlimentoAsync(id, _formulario);
            }
            else
            {
                await Api.CrearAlimentoAsync(_formulario);
            }

            Volver();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Volver() => Navegacion.NavigateTo("/catalogo/alimentos");
}
