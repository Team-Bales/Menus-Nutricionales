<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Menus.Domain\Menus.Domain.csproj" />
    <ProjectReference Include="..\Menus.Application\Menus.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <!-- Explícita para que la 10.0.13 llegue a quien referencia este proyecto. Sin ella, Design (privado) la usa solo
         aquí y la API recibe la 10.0.4 de Npgsql: en ejecución falla la carga del ensamblado. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.20" />
  </ItemGroup>

  <ItemGroup>
    <!-- Restricciones del #11 que EF no declara (triggers e índice de RC-01); ver RestriccionesNoDeclarativas -->
    <EmbeddedResource Include="Persistence\Sql\*.sql" />
    <!-- Consultas informacionales del informe (§2.2) como funciones de PostgreSQL; ver ConsultasInformacionales -->
    <EmbeddedResource Include="Persistence\Consultas\*.sql" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
