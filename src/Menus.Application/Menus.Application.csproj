<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Menus.Domain\Menus.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!-- #325: los proveedores de contexto de IA leen IA:KMinimo con IOptions<IAOptions>; el orquestador (#330) también
         lee IAOptions. Solo la abstracción de opciones, sin dependencia de ASP.NET. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Menus.Application.Tests" />
    <!-- Para que las pruebas de integración de punta a punta (#89) llamen a los manejadores reales en vez de
         repetir su lógica a mano (revisión del #263 y el #277). -->
    <InternalsVisibleTo Include="Menus.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- #94 (requisito 5 de IS): todo tipo y miembro público lleva comentario XML, y sus referencias resuelven.
         Un faltante rompe el build en lugar de quedar como advertencia. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>
