@* Icono SVG en línea, sin dependencias externas. Se usa en el menú, el dashboard,
   los botones y los estados vacíos para mantener un mismo trazo en toda la app. *@
<svg class="icon @CssClass" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "home":
            <path d="M3 10.6 12 3l9 7.6" />
            <path d="M5.5 9.4V20a1 1 0 0 0 1 1h4.2v-6.2h2.6V21h4.2a1 1 0 0 0 1-1V9.4" />
            break;
        case "basket":
            <path d="M4.5 8.5h15l-1.3 10.7a2 2 0 0 1-2 1.8H7.8a2 2 0 0 1-2-1.8L4.5 8.5Z" />
            <path d="m8.5 8.5 3.5-5.5 3.5 5.5" />
            break;
        case "utensils":
            <path d="M4 3v6.5a3 3 0 0 0 6 0V3" />
            <path d="M7 3v18" />
            <path d="M17.5 3c-1.9 2-3 5-3 9h6c0-4-1.1-7-3-9Z" />
            <path d="M17.5 12v9" />
            break;
        case "clipboard":
            <rect x="5" y="4" width="14" height="17" rx="2" />
            <path d="M9 4.5V3h6v1.5" />
            <path d="M8 12.5h2l1.8-3.2 2 6.4 1.7-3.2H16" />
            break;
        case "settings":
            <path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z" />
            <path d="M19.2 14.3a1.6 1.6 0 0 0 .32 1.77l.06.06a1.9 1.9 0 1 1-2.7 2.7l-.06-.06a1.6 1.6 0 0 0-1.77-.32 1.6 1.6 0 0 0-.97 1.47V20a1.9 1.9 0 1 1-3.8 0v-.08a1.6 1.6 0 0 0-1.05-1.47 1.6 1.6 0 0 0-1.77.32l-.06.06a1.9 1.9 0 1 1-2.7-2.7l.06-.06a1.6 1.6 0 0 0 .32-1.77 1.6 1.6 0 0 0-1.47-.97H4a1.9 1.9 0 1 1 0-3.8h.08a1.6 1.6 0 0 0 1.47-1.05 1.6 1.6 0 0 0-.32-1.77l-.06-.06a1.9 1.9 0 1 1 2.7-2.7l.06.06a1.6 1.6 0 0 0 1.77.32H10a1.6 1.6 0 0 0 .97-1.47V4a1.9 1.9 0 1 1 3.8 0v.08a1.6 1.6 0 0 0 .97 1.47 1.6 1.6 0 0 0 1.77-.32l.06-.06a1.9 1.9 0 1 1 2.7 2.7l-.06.06a1.6 1.6 0 0 0-.32 1.77V10a1.6 1.6 0 0 0 1.47.97H20a1.9 1.9 0 1 1 0 3.8h-.08a1.6 1.6 0 0 0-1.47.97Z" />
            break;
        case "users":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="9" cy="10" r="2.3" />
            <path d="M5.3 17c.7-1.9 2.1-2.8 3.7-2.8s3 1 3.7 2.8" />
            <path d="M15 9.5h4M15 13h4" />
            break;
        case "hospital":
            <path d="M4.5 21V5.8a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2V21" />
            <path d="M2.5 21h19" />
            <path d="M12 7v6M9 10h6" />
            <path d="M9.5 21v-4h5v4" />
            break;
        case "user":
            <circle cx="12" cy="8" r="3.8" />
            <path d="M4.5 21c0-4.1 3.3-7 7.5-7s7.5 2.9 7.5 7" />
            break;
        case "logout":
            <path d="M9.5 21H5.5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="m16 17 5-5-5-5" />
            <path d="M21 12H9.5" />
            break;
        case "chevron-right":
            <path d="m9 5 7 7-7 7" />
            break;
        case "arrow-left":
            <path d="m12 5-7 7 7 7M5 12h14" />
            break;
        case "arrow-up-right":
            <path d="M7 17 17 7M8 7h9v9" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m20 20-4-4" />
            break;
        case "bell":
            <path d="M18 8.5a6 6 0 0 0-12 0c0 6.5-2.5 6.5-2.5 8.5h17c0-2-2.5-2-2.5-8.5" />
            <path d="M10 20h4" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
            break;
        case "alert":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5M12 16h.01" />
            break;
        case "leaf":
            <path d="M20 4c-9 0-15 3.5-15 10a5 5 0 0 0 5 5c6.5 0 10-6 10-15Z" />
            <path d="M4 21c2.5-4.5 6-8 11-10.5" />
            break;
        case "sparkles":
            <path d="m12 3 1.7 4.6L18 9l-4.3 1.4L12 15l-1.7-4.6L6 9l4.3-1.4L12 3Z" />
            <path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z" />
            break;
        case "chart":
            <path d="M4 20h16" />
            <path d="M7 16v-5M12 16V6M17 16v-8" />
            break;
        case "shield":
            <path d="M12 21s7-3.2 7-9V5.8L12 3 5 5.8V12c0 5.8 7 9 7 9Z" />
            <path d="m9 12 2 2 4-4" />
            break;
        case "trash":
            <path d="M4 7h16M9 7V4.5h6V7M6 7l1 13h10l1-13" />
            <path d="M10 11v5M14 11v5" />
            break;
        case "pencil":
            <path d="m15.5 5.5 3 3M4 20l.8-3.7L16.1 5a1.8 1.8 0 0 1 2.6 2.6L7.4 18.9 4 20Z" />
            break;
        case "eye":
            <path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
            <circle cx="12" cy="12" r="2.8" />
            break;
        case "filter":
            <path d="M4 6h16M7 12h10M10 18h4" />
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="16" rx="2" />
            <path d="M8 3v4M16 3v4M3.5 10h17" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3.2 2" />
            break;
        case "heart":
            <path d="M12 20s-7.5-4.6-7.5-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20Z" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "folder":
            <path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-10Z" />
            break;
        case "activity":
            <path d="M3 12h4l3-7 4 14 3-7h4" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    /// <summary>Nombre del trazo a dibujar (p. ej. <c>home</c>, <c>basket</c>, <c>logout</c>).</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Clases CSS adicionales que se aplican al elemento <c>svg</c>.</summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;
}
