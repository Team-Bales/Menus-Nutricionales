@* Perfil de quien tiene la sesión (/perfil): el correo y el rol, leídos de la API, y el botón
   para cerrar sesión. *@
@page "/perfil"
@attribute [Authorize]
@inject IAutenticacionApi Api
@inject ISesionAutenticada Sesion
@inject NavigationManager Navegacion

<PageTitle>Mi perfil</PageTitle>

<div class="page-heading">
    <div class="page-heading-main">
        <h1 class="page-title">Mi perfil</h1>
        <p class="page-subtitle">Datos de la sesión actual.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_perfil is null)
{
    <EstadoDeCarga Texto="Cargando perfil…" />
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@_perfil.Email</dd>
        <dt class="col-sm-3">Rol</dt><dd class="col-sm-9">@_perfil.Rol</dd>
    </dl>
    <button class="btn btn-outline-danger" @onclick="CerrarSesion">Cerrar sesión</button>
}

@code {
    private PerfilUsuario? _perfil;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _perfil = await Api.ObtenerPerfilAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _error = MensajesDeConexion.SinServidor;
        }
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesionAsync();
        Navegacion.NavigateTo(RutasDeSesion.Login);
    }
}
