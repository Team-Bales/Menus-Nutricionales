@* Raíz del cliente: el enrutador con autorización. Cada página declara su rol con [Authorize]; si no
   lo cumple, se muestra AccesoDenegado o se redirige al login (ver NotAuthorized). *@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="estado">
                    @* Sin sesión: al login, recordando la página. Con sesión pero sin el rol: aviso, no login. *@
                    @if (estado.User.Identity?.IsAuthenticated == true)
                    {
                        <AccesoDenegado />
                    }
                    else
                    {
                        <RedirigirALogin />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
