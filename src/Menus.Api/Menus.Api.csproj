<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- #287 (requisito 5 de IS), como Domain y Application desde el #94: todo tipo y miembro público lleva
         comentario XML, y sus referencias resuelven. Un faltante rompe el build en lugar de quedar como advertencia. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Menus.Application\Menus.Application.csproj" />
    <ProjectReference Include="..\Menus.Infrastructure\Menus.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Menus.Api.Tests" />
  </ItemGroup>

</Project>
