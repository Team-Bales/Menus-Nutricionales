@page "/admin/nutricionistas/{Id:guid}"
@attribute [Authorize(Roles = RolesDeUsuario.Admin)]
@inject IAdministracionApi Api
@inject ICatalogoApi Catalogo
@inject NavigationManager Navegacion

<PageTitle>Detalle de nutricionista</PageTitle>

@if (_nutricionista is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h1 class="h2 mb-1">@_nutricionista.Nombre</h1><p class="text-muted mb-0">@NombreEspecialidad(_nutricionista.EspecialidadId)</p></div><button class="btn btn-outline-secondary" @onclick="Volver">Volver a nutricionistas</button></div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }
    <div class="card shadow-sm"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-4"><h2 class="h5 mb-0">Dietas autorizadas</h2>@if (_nutricionista.EsJefe) { <span class="badge text-bg-success">Jefe de nutrición</span> } else { <button class="btn btn-outline-primary" @onclick="AsignarJefatura">Designar jefe</button> }</div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Dieta</th><th class="text-end">Acciones</th></tr></thead><tbody>
            @if (_nutricionista.DietasAutorizadas.Count == 0) { <tr><td colspan="2" class="text-center text-muted py-4">No tiene dietas autorizadas.</td></tr> }
            @foreach (var autorizada in _nutricionista.DietasAutorizadas) { <tr><td>@NombreDieta(autorizada.DietaId)</td><td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="(() => Revocar(autorizada.DietaId))">Revocar</button></td></tr> }
        </tbody></table></div>
        <div class="row g-2 align-items-end"><div class="col"><label class="form-label" for="dieta">Dieta</label><select id="dieta" class="form-select" @bind="_dietaSeleccionada"><option value="@Guid.Empty">Selecciona una dieta</option>@foreach (var dieta in DietasNoAutorizadas) { <option value="@dieta.Id">@dieta.Nombre</option> }</select></div><div class="col-auto"><button class="btn btn-primary" @onclick="Autorizar">Autorizar dieta</button></div></div>
    </div></div>
}
else if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }
else { <p class="text-muted">Cargando nutricionista…</p> }

@code {
    [Parameter] public Guid Id { get; set; }
    private NutricionistaDetalle? _nutricionista;
    private IReadOnlyList<Nomenclador> _especialidades = [];
    private IReadOnlyList<Dieta> _dietas = [];
    private Guid _dietaSeleccionada;
    private string? _error;
    private IEnumerable<Dieta> DietasNoAutorizadas => _nutricionista is null ? [] : _dietas.Where(d => !_nutricionista.DietasAutorizadas.Any(a => a.DietaId == d.Id));

    protected override async Task OnParametersSetAsync() => await Cargar();
    private async Task Cargar()
    {
        _error = null;
        try { _especialidades = await Catalogo.ListarEspecialidadesAsync(); _dietas = await Catalogo.ListarTodasLasDietasAsync(); _nutricionista = await Api.ObtenerNutricionistaAsync(Id); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task Autorizar()
    {
        if (_dietaSeleccionada == Guid.Empty) { _error = "Selecciona una dieta."; return; }
        await EjecutarYRecargar(() => Api.AutorizarDietaAsync(Id, _dietaSeleccionada));
        _dietaSeleccionada = Guid.Empty;
    }

    private Task Revocar(Guid dietaId) => EjecutarYRecargar(() => Api.RevocarDietaAsync(Id, dietaId));
    private Task AsignarJefatura() => EjecutarYRecargar(() => Api.AsignarRolJefeAsync(Id));
    private async Task EjecutarYRecargar(Func<Task> accion) { _error = null; try { await accion(); await Cargar(); } catch (ApiException ex) { _error = ex.Message; } }
    private void Volver() => Navegacion.NavigateTo("/admin/nutricionistas");
    private string NombreEspecialidad(Guid id) => _especialidades.FirstOrDefault(e => e.Id == id)?.Nombre ?? "—";
    private string NombreDieta(Guid id) => _dietas.FirstOrDefault(d => d.Id == id)?.Nombre ?? "—";
}
