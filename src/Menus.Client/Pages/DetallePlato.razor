@page "/catalogo/platos/{Id:guid}"
@inject ICatalogoApi Api
@inject NavigationManager Navegacion

<PageTitle>@(_plato?.Nombre ?? "Detalle del plato")</PageTitle>

@if (_cargando) { <p class="text-muted">Cargando plato…</p> }
else if (_plato is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h1 class="h2 mb-1">@_plato.Nombre</h1><p class="text-muted mb-0">Composición del plato.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" @onclick="Editar">Editar clasificación</button><button class="btn btn-outline-secondary" @onclick="Volver">Volver</button></div></div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }
    <div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Ingredientes</h2><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Alimento</th><th>Cantidad</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var ingrediente in _plato.Ingredientes) { <tr><td>@ingrediente.Nombre</td><td>@ingrediente.Cantidad</td><td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="(() => Quitar(ingrediente))">Quitar</button></td></tr> }</tbody></table></div></div></div>
    <div class="card shadow-sm"><div class="card-body"><h2 class="h5">Agregar ingrediente</h2><div class="row g-3 align-items-end"><div class="col-12 col-md-7"><label class="form-label" for="alimento">Alimento</label><select id="alimento" class="form-select" @bind="_nuevoIngrediente.AlimentoId"><option value="@Guid.Empty">Selecciona un alimento</option>@foreach (var alimento in _alimentosDisponibles) { <option value="@alimento.Id">@alimento.Nombre</option> }</select></div><div class="col-8 col-md-3"><label class="form-label" for="cantidad">Cantidad</label><InputNumber id="cantidad" class="form-control" @bind-Value="_nuevoIngrediente.Cantidad" /></div><div class="col-4 col-md-2"><button class="btn btn-primary w-100" @onclick="Agregar">Agregar</button></div></div></div></div>
}
else { <div class="alert alert-danger" role="alert">@(_error ?? "No se pudo cargar el plato.")</div> }

@code {
    [Parameter] public Guid Id { get; set; }
    private PlatoDetalle? _plato;
    private IReadOnlyList<Alimento> _alimentos = [];
    private readonly IngredienteFormulario _nuevoIngrediente = new();
    private bool _cargando = true;
    private string? _error;
    private IEnumerable<Alimento> _alimentosDisponibles => _alimentos.Where(a => _plato is null || !_plato.Ingredientes.Any(i => i.AlimentoId == a.Id));

    protected override async Task OnParametersSetAsync() => await Cargar();

    private async Task Cargar()
    {
        _cargando = true;
        _error = null;
        try
        {
            _plato = await Api.ObtenerPlatoAsync(Id);
            _alimentos = await Api.ListarTodosLosAlimentosAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private async Task Agregar()
    {
        if (_nuevoIngrediente.AlimentoId == Guid.Empty || _nuevoIngrediente.Cantidad <= 0) { _error = "Selecciona un alimento y una cantidad mayor que cero."; return; }
        try { await Api.AgregarIngredienteAsync(Id, _nuevoIngrediente); _nuevoIngrediente.AlimentoId = Guid.Empty; _nuevoIngrediente.Cantidad = 1m; await Cargar(); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task Quitar(Ingrediente ingrediente)
    {
        try { await Api.QuitarIngredienteAsync(Id, ingrediente.AlimentoId); await Cargar(); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private void Editar() => Navegacion.NavigateTo($"/catalogo/platos/{Id}/editar");
    private void Volver() => Navegacion.NavigateTo("/catalogo/platos");
}
