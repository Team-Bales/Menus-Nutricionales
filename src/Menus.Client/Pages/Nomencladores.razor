@page "/admin/nomencladores"
@inject ICatalogoApi Api

<PageTitle>Nomencladores</PageTitle>

<div class="mb-4"><h1 class="h2 mb-1">Nomencladores</h1><p class="text-muted mb-0">Catálogos institucionales para configurar la aplicación.</p></div>

@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }

<div class="btn-group mb-3" role="group" aria-label="Tipo de nomenclador">
    @foreach (var seccion in Secciones)
    {
        <button class="btn @(seccion.Tipo == _tipo ? "btn-primary" : "btn-outline-primary")" @onclick="(() => CambiarTipo(seccion.Tipo))">@seccion.Titulo</button>
    }
</div>

<div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">@TituloActual</h2>
    <EditForm Model="_formulario" OnValidSubmit="Crear" class="row g-2 align-items-start mb-4">
        <DataAnnotationsValidator />
        <div class="col"><label class="form-label" for="nombre-nomenclador">Nombre</label><InputText id="nombre-nomenclador" class="form-control" @bind-Value="_formulario.Nombre" /><ValidationMessage For="@(() => _formulario.Nombre)" /></div>
        <div class="col-auto pt-4"><button class="btn btn-primary" type="submit">Agregar</button></div>
    </EditForm>
    @if (_cargando) { <p class="text-muted">Cargando nomencladores…</p> }
    else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Nombre</th><th class="text-end">Acciones</th></tr></thead><tbody>@if (_elementos.Count == 0) { <tr><td colspan="2" class="text-center text-muted py-4">No hay elementos registrados.</td></tr> } @foreach (var elemento in _elementos) { <tr><td>@elemento.Nombre</td><td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="(() => Eliminar(elemento.Id))">Eliminar</button></td></tr> }</tbody></table></div> }
</div></div>

@code {
    private static readonly (TipoDeNomenclador Tipo, string Titulo)[] Secciones = [(TipoDeNomenclador.GruposNutricionales, "Grupos nutricionales"), (TipoDeNomenclador.RestriccionesAlimentarias, "Restricciones alimentarias"), (TipoDeNomenclador.ProgramasAtencion, "Programas de atención"), (TipoDeNomenclador.Especialidades, "Especialidades")];
    private TipoDeNomenclador _tipo = TipoDeNomenclador.GruposNutricionales;
    private IReadOnlyList<Nomenclador> _elementos = [];
    private NomencladorFormulario _formulario = new();
    private bool _cargando = true;
    private string? _error;
    private string TituloActual => Secciones.Single(s => s.Tipo == _tipo).Titulo;

    protected override async Task OnInitializedAsync() => await Cargar();
    private async Task CambiarTipo(TipoDeNomenclador tipo) { _tipo = tipo; _formulario = new(); await Cargar(); }
    private async Task Cargar()
    {
        _cargando = true; _error = null;
        try { _elementos = _tipo switch { TipoDeNomenclador.GruposNutricionales => await Api.ListarGruposAsync(), TipoDeNomenclador.RestriccionesAlimentarias => await Api.ListarRestriccionesAsync(), TipoDeNomenclador.ProgramasAtencion => await Api.ListarProgramasAsync(), _ => await Api.ListarEspecialidadesAsync(), }; }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }
    private async Task Crear() { _error = null; try { await Api.CrearNomencladorAsync(_tipo, _formulario); _formulario = new(); await Cargar(); } catch (ApiException ex) { _error = ex.Message; } }
    private async Task Eliminar(Guid id) { _error = null; try { await Api.EliminarNomencladorAsync(_tipo, id); await Cargar(); } catch (ApiException ex) { _error = ex.Message; } }
}
