@* Inicio de sesión (/login), sin el menú lateral (LayoutVacio). Guarda el token en la sesión y
   vuelve a returnUrl solo si es una ruta local (RutasDeSesion.DestinoSeguro), para no redirigir a
   otro sitio. La lógica no cambia en el rediseño visual del #348. *@
@page "/login"
@layout LayoutVacio
@inject IAutenticacionApi Api
@inject ISesionAutenticada Sesion
@inject NavigationManager Navegacion
@inject IWebAssemblyHostEnvironment Entorno

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-shell">
    <section class="login-brand">
        <div class="login-brand-top">
            <span class="brand-mark">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 4c-9 0-15 3.5-15 10a5 5 0 0 0 5 5c6.5 0 10-6 10-15Z"/><path d="M4 21c2.5-4.5 6-8 11-10.5"/></svg>
            </span>
            <span class="brand-text">
                <span class="brand-name">Menús nutricionales</span>
                <span class="brand-tagline">Centro de nutrición</span>
            </span>
        </div>

        <div class="login-brand-center">
            <span class="eyebrow">Nutrición clínica</span>
            <p class="login-brand-title">Nutrición clínica, <em>decisiones claras</em></p>
            <p>Un único lugar para el catálogo de alimentos, las dietas y el equipo nutricional.</p>
            <ul class="login-features">
                <li>
                    <span class="feature-check"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7"/></svg></span>
                    Catálogo centralizado
                </li>
                <li>
                    <span class="feature-check"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7"/></svg></span>
                    Dietas trazables
                </li>
                <li>
                    <span class="feature-check"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7"/></svg></span>
                    Equipo autorizado
                </li>
            </ul>
        </div>

        <div class="login-brand-bottom">Menús Nutricionales · 2026</div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="login-card-head">
                <span class="eyebrow">Acceso al sistema</span>
                <h1>Te damos la bienvenida</h1>
                <p>Ingresa a tu cuenta para continuar.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }

            <EditForm Model="_credenciales" OnValidSubmit="IniciarSesion" class="login-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="email">Correo electrónico</label>
                    <div class="input-with-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                        <InputText id="email" class="form-control" @bind-Value="_credenciales.Email" autocomplete="username" />
                    </div>
                    <ValidationMessage For="@(() => _credenciales.Email)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Contraseña</label>
                    <div class="input-with-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <InputText id="password" class="form-control" type="password" @bind-Value="_credenciales.Password" autocomplete="current-password" />
                    </div>
                    <ValidationMessage For="@(() => _credenciales.Password)" />
                </div>
                <button class="btn btn-primary" disabled="@_enviando" type="submit">Entrar</button>
            </EditForm>

            @* Las credenciales de ejemplo son pública y solo tienen sentido en desarrollo: no se las
               señala en un despliegue real. *@
            @if (Entorno.IsDevelopment())
            {
                <div class="login-demo">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                    <span>En entornos de demostración, las credenciales están en <a href="https://github.com/Team-Bales/Menus-Nutricionales/blob/main/scripts/datos-ejemplo/README.md" target="_blank" rel="noopener">datos de ejemplo</a>.</span>
                </div>
            }

            <p class="login-legal">Acceso para el personal y los pacientes del centro.</p>
        </div>
    </section>
</div>

@code {
    /// <summary>Página a la que se vuelve tras iniciar sesión; solo se aceptan rutas locales.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly CredencialesLogin _credenciales = new();
    private bool _enviando;
    private string? _error;

    private async Task IniciarSesion()
    {
        _enviando = true;
        _error = null;
        try
        {
            var resultado = await Api.IniciarSesionAsync(_credenciales);
            await Sesion.IniciarSesionAsync(resultado.Token);
            Navegacion.NavigateTo(RutasDeSesion.DestinoSeguro(ReturnUrl));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // API caída, sin red, CORS o tiempo de espera agotado.
            _error = MensajesDeConexion.SinServidor;
        }
        finally
        {
            _enviando = false;
        }
    }
}
