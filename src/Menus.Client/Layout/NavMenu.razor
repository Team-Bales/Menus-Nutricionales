@* Menú lateral. Muestra solo los enlaces que permite el rol de la sesión: el catálogo al personal
   (Admin y nutricionista), la administración al Admin, y el perfil y cerrar sesión a cualquiera
   con sesión. Ocultar un enlace no protege la página: cada una declara su propio [Authorize].
   La forma (secciones, iconos y tarjeta de usuario) cambia en el #347; las reglas no. *@
<div class="sidebar-header">
    <a class="sidebar-brand" href="">
        <span class="brand-mark"><Icon Name="leaf" /></span>
        <span class="brand-text">
            <span class="brand-name">Menús nutricionales</span>
            <span class="brand-tagline">Centro de nutrición</span>
        </span>
    </a>
    <button aria-label="Menú de navegación" aria-expanded="@(collapseNavMenu ? "false" : "true")" class="navbar-toggler sidebar-toggle" @onclick="ToggleNavMenu">
        <Icon Name="menu" />
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable sidebar-body" @onclick="ToggleNavMenu">
    <nav class="sidebar-nav">
        <AuthorizeView Context="estado">
            <Authorized>
                <span class="sidebar-section-label">General</span>
                <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
                    <Icon Name="home" /> Inicio
                </NavLink>

                @if (RolesDeUsuario.EsPersonal(estado.User))
                {
                    <span class="sidebar-section-label">Catálogo</span>
                    <NavLink class="sidebar-link" href="catalogo/alimentos">
                        <Icon Name="basket" /> Alimentos
                    </NavLink>
                    <NavLink class="sidebar-link" href="catalogo/platos">
                        <Icon Name="utensils" /> Platos
                    </NavLink>
                    <NavLink class="sidebar-link" href="catalogo/dietas">
                        <Icon Name="clipboard" /> Dietas
                    </NavLink>
                }

                @if (estado.User.IsInRole(RolesDeUsuario.Nutricionista))
                {
                    <span class="sidebar-section-label">Generación</span>
                    <NavLink class="sidebar-link" href="menus">
                        <Icon Name="sparkles" /> Menús
                    </NavLink>
                }

                @if (estado.User.IsInRole(RolesDeUsuario.Admin))
                {
                    <span class="sidebar-section-label">Administración</span>
                    <NavLink class="sidebar-link" href="admin/nomencladores">
                        <Icon Name="settings" /> Nomencladores
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/nutricionistas">
                        <Icon Name="users" /> Nutricionistas
                    </NavLink>
                    <NavLink class="sidebar-link" href="admin/salas">
                        <Icon Name="hospital" /> Salas
                    </NavLink>
                }

                <span class="sidebar-section-label">Mi cuenta</span>
                <NavLink class="sidebar-link" href="perfil">
                    <Icon Name="user" /> Mi perfil
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink class="sidebar-link" href="login">Iniciar sesión</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <div class="sidebar-spacer"></div>

    <AuthorizeView Context="estado">
        <Authorized>
            <div class="sidebar-footer">
                <div class="sidebar-footer-label">Sesión activa</div>
                <div class="sidebar-footer-row">
                    <span class="avatar avatar-dark" aria-hidden="true"><Icon Name="user" /></span>
                    <div>
                        <div class="sidebar-footer-role">@NombreRol(estado.User)</div>
                        <div class="sidebar-footer-caption">Menús Nutricionales</div>
                    </div>
                </div>
                <button class="sidebar-logout" @onclick="CerrarSesion"><Icon Name="logout" />Cerrar sesión</button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Inject] private ISesionAutenticada Sesion { get; set; } = null!;
    [Inject] private NavigationManager Navegacion { get; set; } = null!;

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesionAsync();
        Navegacion.NavigateTo(RutasDeSesion.Login);
    }

    private static string NombreRol(System.Security.Claims.ClaimsPrincipal usuario)
    {
        if (usuario.IsInRole(RolesDeUsuario.Admin))
        {
            return "Administrador";
        }

        return usuario.IsInRole(RolesDeUsuario.Nutricionista) ? "Nutricionista" : "Paciente";
    }
}
