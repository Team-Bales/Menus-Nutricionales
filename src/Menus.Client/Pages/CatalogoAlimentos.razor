@page "/catalogo/alimentos"
@inject ICatalogoApi Api
@inject NavigationManager Navegacion

<PageTitle>Alimentos</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Alimentos</h1>
        <p class="text-muted mb-0">Banco de alimentos disponible para la elaboración de menús.</p>
    </div>
    <button class="btn btn-primary" @onclick="Nuevo">Nuevo alimento</button>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="grupo">Grupo nutricional</label>
                <select id="grupo" class="form-select" @bind="_grupo">
                    <option value="">Todos</option>
                    @foreach (var grupo in _grupos)
                    {
                        <option value="@grupo.Id">@grupo.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="tipo">Tipo de preparación</label>
                <select id="tipo" class="form-select" @bind="_tipo">
                    <option value="">Todos</option>
                    @foreach (var tipo in _tipos)
                    {
                        <option value="@tipo.Id">@tipo.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="nivel">Nivel calórico</label>
                <select id="nivel" class="form-select" @bind="_nivel">
                    <option value="">Todos</option>
                    @foreach (var nivel in _niveles)
                    {
                        <option value="@nivel.Id">@nivel.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-outline-primary flex-grow-1" @onclick="AplicarFiltros">Filtrar</button>
                <button class="btn btn-outline-secondary" title="Limpiar filtros" @onclick="LimpiarFiltros">Limpiar</button>
            </div>
        </div>
    </div>
</div>

@if (_cargando)
{
    <p class="text-muted">Cargando alimentos…</p>
}
else if (_pagina is not null)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Nombre</th><th>Grupo nutricional</th><th>Tipo</th><th>Nivel calórico</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @if (_pagina.Data.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay alimentos con esos filtros.</td></tr>
                }
                @foreach (var alimento in _pagina.Data)
                {
                    <tr>
                        <td>@alimento.Nombre</td>
                        <td>@Nombre(_grupos, alimento.GrupoNutricionalId)</td>
                        <td>@Nombre(_tipos, alimento.TipoPreparacionId)</td>
                        <td>@Nombre(_niveles, alimento.NivelCaloricoId)</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="(() => Editar(alimento.Id))">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => Eliminar(alimento))">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@_pagina.Total resultado(s)</span>
        <div class="btn-group" role="group" aria-label="Paginación">
            <button class="btn btn-outline-secondary" disabled="@(_pagina.Page == 1)" @onclick="PaginaAnterior">Anterior</button>
            <button class="btn btn-outline-secondary" disabled="@(_pagina.Page * _pagina.Size >= _pagina.Total)" @onclick="PaginaSiguiente">Siguiente</button>
        </div>
    </div>
}

@code {
    private IReadOnlyList<Nomenclador> _grupos = [];
    private IReadOnlyList<Nomenclador> _tipos = [];
    private IReadOnlyList<Nomenclador> _niveles = [];
    private Pagina<Alimento>? _pagina;
    private Guid? _grupo;
    private Guid? _tipo;
    private Guid? _nivel;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarNomencladores();
        await CargarPagina(1);
    }

    private async Task CargarNomencladores()
    {
        try
        {
            _grupos = await Api.ListarGruposAsync();
            _tipos = await Api.ListarTiposPreparacionAsync();
            _niveles = await Api.ListarNivelesCaloricosAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CargarPagina(int page)
    {
        _cargando = true;
        _error = null;
        try
        {
            _pagina = await Api.ListarAlimentosAsync(_grupo, _tipo, _nivel, page, 10);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task AplicarFiltros() => CargarPagina(1);

    private async Task LimpiarFiltros()
    {
        _grupo = _tipo = _nivel = null;
        await CargarPagina(1);
    }

    private Task PaginaAnterior() => CargarPagina(Math.Max(1, (_pagina?.Page ?? 2) - 1));
    private Task PaginaSiguiente() => CargarPagina((_pagina?.Page ?? 0) + 1);

    private async Task Eliminar(Alimento alimento)
    {
        _error = null;
        try
        {
            await Api.EliminarAlimentoAsync(alimento.Id);
            await CargarPagina(_pagina?.Page ?? 1);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void Nuevo() => Navegacion.NavigateTo("/catalogo/alimentos/nuevo");
    private void Editar(Guid id) => Navegacion.NavigateTo($"/catalogo/alimentos/{id}/editar");

    private static string Nombre(IEnumerable<Nomenclador> nomencladores, Guid id)
        => nomencladores.FirstOrDefault(n => n.Id == id)?.Nombre ?? "—";
}
