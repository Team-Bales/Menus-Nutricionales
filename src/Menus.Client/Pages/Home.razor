@* Portada (/), para cualquier usuario con sesión (#337). Explica qué es la aplicación y ofrece accesos a las
   secciones que ya existen, con los mismos criterios de rol que NavMenu: el catálogo al personal (Admin y
   nutricionista), la administración al Admin y el perfil a todos. Ocultar un acceso no protege la página: cada
   una declara su propio [Authorize]. El #349 añade las métricas del catálogo sobre esa portada; el panel del
   paciente con menús, consumo y valoraciones llegará con el #88. *@
@page "/"
@attribute [Authorize]
@inject ICatalogoApi Catalogo
@inject IAdministracionApi Administracion
@inject AuthenticationStateProvider Estado

<PageTitle>Menús nutricionales</PageTitle>

<div class="dashboard-hero">
    <div class="dashboard-hero-copy">
        <span class="eyebrow">Panel de trabajo</span>
        <h1>Menús nutricionales</h1>
        <p>
            Gestión de la generación automática de menús nutricionales en una institución de salud: alimentos y platos,
            dietas, nutricionistas, pacientes, y la generación, validación y valoración de los menús.
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_esPersonal)
{
    <section class="stats-grid" aria-label="Resumen del catálogo">
        <div class="stat-card">
            <span class="stat-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 8.5h15l-1.3 10.7a2 2 0 0 1-2 1.8H7.8a2 2 0 0 1-2-1.8L4.5 8.5Z"/><path d="m8.5 8.5 3.5-5.5 3.5 5.5"/></svg></span>
            <div class="stat-body">
                <div class="stat-value">@(_alimentos?.ToString() ?? "—")</div>
                <div class="stat-label">Alimentos</div>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon stat-icon-amber"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v6.5a3 3 0 0 0 6 0V3"/><path d="M7 3v18"/><path d="M17.5 3c-1.9 2-3 5-3 9h6c0-4-1.1-7-3-9Z"/><path d="M17.5 12v9"/></svg></span>
            <div class="stat-body">
                <div class="stat-value">@(_platos?.ToString() ?? "—")</div>
                <div class="stat-label">Platos</div>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon stat-icon-blue"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5V3h6v1.5"/><path d="M8 12.5h2l1.8-3.2 2 6.4 1.7-3.2H16"/></svg></span>
            <div class="stat-body">
                <div class="stat-value">@(_totalDietas?.ToString() ?? "—")</div>
                <div class="stat-label">Dietas</div>
            </div>
        </div>
        @if (_esAdmin)
        {
            <div class="stat-card">
                <span class="stat-icon stat-icon-violet"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2.3"/><path d="M5.3 17c.7-1.9 2.1-2.8 3.7-2.8s3 1 3.7 2.8"/><path d="M15 9.5h4M15 13h4"/></svg></span>
                <div class="stat-body">
                    <div class="stat-value">@(_nutricionistas?.ToString() ?? "—")</div>
                    <div class="stat-label">Nutricionistas</div>
                </div>
            </div>
            <div class="stat-card">
                <span class="stat-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 21V5.8a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2V21"/><path d="M2.5 21h19"/><path d="M12 7v6M9 10h6"/><path d="M9.5 21v-4h5v4"/></svg></span>
                <div class="stat-body">
                    <div class="stat-value">@(_salas?.ToString() ?? "—")</div>
                    <div class="stat-label">Salas</div>
                </div>
            </div>
        }
    </section>
}

<AuthorizeView Context="estado">
    <Authorized>
        @if (RolesDeUsuario.EsPersonal(estado.User))
        {
            <section class="mb-4" aria-labelledby="portada-catalogo">
                <h2 id="portada-catalogo" class="h4">Catálogo</h2>
                <ul class="list-unstyled">
                    <li><a href="catalogo/alimentos">Alimentos</a>: banco de alimentos para la elaboración de menús.</li>
                    <li><a href="catalogo/platos">Platos</a>: banco de platos y su composición de alimentos.</li>
                    <li><a href="catalogo/dietas">Dietas</a>: planes de alimentación por programa de atención.</li>
                </ul>
            </section>

            @* Las dietas no tienen fecha de creación: el listado viene ordenado por nombre, así que se presentan
               como las primeras del catálogo, no como «recientes». *@
            @if (_dietas.Count > 0)
            {
                <section class="mb-4" aria-labelledby="portada-dietas">
                    <h2 id="portada-dietas" class="h4">Dietas</h2>
                    <ul class="list-unstyled">
                        @foreach (var dieta in _dietas)
                        {
                            <li><a href="@($"catalogo/dietas/{dieta.Id}")">@dieta.Nombre</a></li>
                        }
                    </ul>
                    <a href="catalogo/dietas">Ver todas</a>
                </section>
            }
        }
        @if (estado.User.IsInRole(RolesDeUsuario.Admin))
        {
            <section class="mb-4" aria-labelledby="portada-administracion">
                <h2 id="portada-administracion" class="h4">Administración</h2>
                <ul class="list-unstyled">
                    <li>
                        <a href="admin/nomencladores">Nomencladores</a>: grupos nutricionales, restricciones alimentarias,
                        programas de atención y especialidades.
                    </li>
                    <li><a href="admin/nutricionistas">Nutricionistas</a>: profesionales registrados y sus dietas autorizadas.</li>
                    <li><a href="admin/salas">Salas</a>: salas de hospitalización y sus pacientes asignados.</li>
                </ul>
            </section>
        }
        <section class="mb-4" aria-labelledby="portada-cuenta">
            <h2 id="portada-cuenta" class="h4">Tu cuenta</h2>
            <ul class="list-unstyled">
                <li><a href="perfil">Mi perfil</a>: tu correo y tu rol.</li>
            </ul>
        </section>
    </Authorized>
</AuthorizeView>

@code {
    private int? _alimentos;
    private int? _platos;
    private int? _totalDietas;
    private int? _nutricionistas;
    private int? _salas;
    private IReadOnlyList<Dieta> _dietas = [];
    private bool _esPersonal;
    private bool _esAdmin;
    private string? _error;

    /// <summary>Carga los totales que permite el rol de la sesión, sin añadir endpoints nuevos.</summary>
    protected override async Task OnInitializedAsync()
    {
        var usuario = (await Estado.GetAuthenticationStateAsync()).User;
        _esPersonal = RolesDeUsuario.EsPersonal(usuario);
        _esAdmin = usuario.IsInRole(RolesDeUsuario.Admin);

        if (_esPersonal)
        {
            await CargarCatalogo();
        }

        if (_esAdmin)
        {
            await CargarAdministracion();
        }
    }

    /// <summary>
    /// Cada cifra se pide y se asigna por separado: si falla una, las demás tarjetas conservan su número.
    /// Una sola petición de dietas de a cinco sirve para el total y para la lista.
    /// </summary>
    private async Task CargarCatalogo()
    {
        _alimentos = (await ConsultarPaginaAsync(() => Catalogo.ListarAlimentosAsync(null, null, null, 1, 1)))?.Total;
        _platos = (await ConsultarPaginaAsync(() => Catalogo.ListarPlatosAsync(null, null, null, 1, 1)))?.Total;
        var dietas = await ConsultarPaginaAsync(() => Catalogo.ListarDietasAsync(null, 1, 5));
        if (dietas is not null)
        {
            _totalDietas = dietas.Total;
            _dietas = dietas.Data;
        }
    }

    private async Task CargarAdministracion()
    {
        _nutricionistas = (await ConsultarPaginaAsync(() => Administracion.ListarNutricionistasAsync(null, 1, 1)))?.Total;
        _salas = (await ConsultarListaAsync(() => Administracion.ListarSalasAsync()))?.Count;
    }

    /// <summary>Una página, o nulo si falló esa consulta; el aviso se guarda sin borrar el primero.</summary>
    private async Task<Pagina<T>?> ConsultarPaginaAsync<T>(Func<Task<Pagina<T>>> consulta)
    {
        try
        {
            return await consulta();
        }
        catch (ApiException ex)
        {
            MostrarPrimerError(ex.Message);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            MostrarPrimerError(MensajesDeConexion.SinServidor);
        }

        return null;
    }

    /// <summary>Una lista, o nula si falló esa consulta; el aviso se guarda sin borrar el primero.</summary>
    private async Task<IReadOnlyList<T>?> ConsultarListaAsync<T>(Func<Task<IReadOnlyList<T>>> consulta)
    {
        try
        {
            return await consulta();
        }
        catch (ApiException ex)
        {
            MostrarPrimerError(ex.Message);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            MostrarPrimerError(MensajesDeConexion.SinServidor);
        }

        return null;
    }

    /// <summary>Conserva el primer error: un fallo posterior no debe tapar la causa original.</summary>
    private void MostrarPrimerError(string mensaje)
    {
        if (string.IsNullOrWhiteSpace(_error))
        {
            _error = mensaje;
        }
    }
}
