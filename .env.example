# -----------------------------------------------------------------------------
# Variables de entorno de ejemplo. Copiar a `.env` y completar con valores
# reales. `.env` NUNCA se versiona (ver .gitignore) — si un valor real llega
# a subirse por error, se rota la credencial de inmediato, no basta con
# borrar el commit.
# -----------------------------------------------------------------------------

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# --- PostgreSQL (datos relacionales: dietas, menús, pacientes, nutricionistas) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=menus_nutricionales
POSTGRES_USER=menus_app
POSTGRES_PASSWORD=change_me
ConnectionStrings__Postgres=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# --- MongoDB (ficha nutricional ampliada de cada alimento) ---
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=fichas_nutricionales
MONGO_USER=menus_app
MONGO_PASSWORD=change_me
ConnectionStrings__Mongo=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# --- Redis (caché de consultas calientes — disponibilidad calórica y valoraciones recientes) ---
REDIS_HOST=redis
REDIS_PORT=6379
ConnectionStrings__Redis=${REDIS_HOST}:${REDIS_PORT}

# --- Autenticación JWT ---
# La clave debe tener al menos 32 bytes y no se versiona nunca.
Jwt__Key=change_me_to_a_long_random_secret_at_least_32_bytes
Jwt__Issuer=menus-nutricionales-api
Jwt__Audience=menus-nutricionales-api
Jwt__ExpiresMinutes=15
Jwt__ClockSkewSeconds=30

# --- Bootstrap de administrador (AuthBootstrapService) ---
# Configurar para crear el primer usuario Admin al arrancar. No se versionan secretos reales.
AuthBootstrap__Email=admin@ejemplo.com
AuthBootstrap__Password=cambiar_por_password_seguro_min_8_chars

# --- Frontend (Blazor WebAssembly) ---
# El cliente no lee variables de entorno: la dirección de la API está en src/Menus.Client/wwwroot/appsettings*.json
# (en Docker, el mismo origen, y nginx pasa /api/ a la API; con dotnet run, http://localhost:5119/).
