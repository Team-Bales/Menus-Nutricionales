@* Lista paginada de nutricionistas (/admin/nutricionistas), solo Admin, filtrable por
   especialidad. La cantidad de dietas autorizadas sale del detalle de cada
   nutricionista, que se pide fila por fila. *@
@page "/admin/nutricionistas"
@attribute [Authorize(Roles = RolesDeUsuario.Admin)]
@inject IAdministracionApi Api
@inject ICatalogoApi Catalogo
@inject NavigationManager Navegacion

<PageTitle>Nutricionistas</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h1 class="h2 mb-1">Nutricionistas</h1><p class="text-muted mb-0">Profesionales registrados y sus dietas autorizadas.</p></div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="card shadow-sm mb-4"><div class="card-body"><div class="row g-3 align-items-end">
    <div class="col-12 col-md-5"><label class="form-label" for="especialidad">Especialidad</label><select id="especialidad" class="form-select" @bind="_especialidad"><option value="">Todas</option>@foreach (var especialidad in _especialidades) { <option value="@especialidad.Id">@especialidad.Nombre</option> }</select></div>
    <div class="col-12 col-md-3 d-flex gap-2"><button class="btn btn-outline-primary" @onclick="AplicarFiltros">Filtrar</button><button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar</button></div>
</div></div></div>

@if (_cargando)
{
    <p class="text-muted">Cargando nutricionistas…</p>
}
else if (_pagina is not null)
{
    <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Nombre</th><th>Especialidad</th><th>Dietas autorizadas</th><th>Jefe</th><th class="text-end">Acciones</th></tr></thead><tbody>
        @if (_pagina.Data.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted py-4">No hay nutricionistas con esos filtros.</td></tr>
        }
        @foreach (var nutricionista in _pagina.Data)
        {
            <tr><td>@nutricionista.Nombre</td><td>@NombreEspecialidad(nutricionista.EspecialidadId)</td><td>@CantidadDietas(nutricionista.Id)</td><td>@(nutricionista.EsJefe ? "Sí" : "No")</td><td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="(() => VerDetalle(nutricionista.Id))">Ver detalle</button></td></tr>
        }
    </tbody></table></div>
    <div class="d-flex justify-content-between align-items-center"><span class="text-muted small">@_pagina.Total resultado(s)</span><div class="btn-group" role="group" aria-label="Paginación de nutricionistas"><button class="btn btn-outline-secondary" disabled="@(_pagina.Page == 1)" @onclick="PaginaAnterior">Anterior</button><button class="btn btn-outline-secondary" disabled="@(_pagina.Page * _pagina.Size >= _pagina.Total)" @onclick="PaginaSiguiente">Siguiente</button></div></div>
}

@code {
    private IReadOnlyList<Nomenclador> _especialidades = [];
    private Pagina<Nutricionista>? _pagina;
    private Dictionary<Guid, int> _cantidadDietas = [];
    private Guid? _especialidad;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _especialidades = await Catalogo.ListarEspecialidadesAsync(); }
        catch (ApiException ex) { _error = ex.Message; _cargando = false; return; }
        await CargarPagina(1);
    }

    private async Task CargarPagina(int page)
    {
        _cargando = true; _error = null;
        try
        {
            _pagina = await Api.ListarNutricionistasAsync(_especialidad, page, 10);
            var detalles = await Task.WhenAll(_pagina.Data.Select(n => Api.ObtenerNutricionistaAsync(n.Id)));
            _cantidadDietas = detalles.ToDictionary(n => n.Id, n => n.DietasAutorizadas.Count);
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private Task AplicarFiltros() => CargarPagina(1);
    private async Task LimpiarFiltros() { _especialidad = null; await CargarPagina(1); }
    private Task PaginaAnterior() => CargarPagina(Math.Max(1, _pagina!.Page - 1));
    private Task PaginaSiguiente() => CargarPagina(_pagina!.Page + 1);
    private void VerDetalle(Guid id) => Navegacion.NavigateTo($"/admin/nutricionistas/{id}");
    private int CantidadDietas(Guid id) => _cantidadDietas.GetValueOrDefault(id);
    private string NombreEspecialidad(Guid id) => _especialidades.FirstOrDefault(e => e.Id == id)?.Nombre ?? "—";
}
